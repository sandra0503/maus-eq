{
  "name": "maus-eq",
  "version": "1.1.0",
  "description": "Maus EQ — keyboard-mappable dual-channel MIDI EQ + volume for rekordbox/Traktor; map EQ bands to hotkeys and mix hands-free (macOS)",
  "main": "main.js",
  "scripts": {
    "build:helper": "swiftc native/midiout.swift -o native/midiout -framework CoreMIDI -O",
    "build:icon": "node scripts/make-icon.js",
    "start": "electron .",
    "postinstall": "npm run build:helper",
    "dist": "npm run build:helper && electron-builder --mac"
  },
  "author": "Sandra Zollner",
  "license": "MIT",
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mauseq.app",
    "productName": "Maus EQ",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "scripts/afterpack.js",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**"
    ],
    "extraResources": [
      {
        "from": "native/midiout",
        "to": "native/midiout"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    }
  }
}
